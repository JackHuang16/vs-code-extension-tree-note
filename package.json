{
  "name": "vs-code-extension-tree-note",
  "displayName": "Tree Note",
  "description": "A hierarchical note-taking extension for Antigravity.",
  "version": "1.3.0",
  "publisher": "antigravity",
  "author": "Jack Huang",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Plusplus106/vs-code-extension-tree-note.git"
  },
  "bugs": {
    "url": "https://github.com/Plusplus106/vs-code-extension-tree-note/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "treeNoteView",
          "name": "Tree Note"
        }
      ]
    },
    "commands": [
      {
        "command": "treeNote.refreshEntry",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "treeNote.addNote",
        "title": "Add Note",
        "icon": "$(new-file)"
      },
      {
        "command": "treeNote.addFolder",
        "title": "Add Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "treeNote.addRootNote",
        "title": "Add Root Note",
        "icon": "$(new-file)"
      },
      {
        "command": "treeNote.addRootFolder",
        "title": "Add Root Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "treeNote.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "treeNote.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "treeNote.renameNote",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "treeNote.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "treeNote.addRootFolder",
          "when": "view == treeNoteView",
          "group": "navigation@1"
        },
        {
          "command": "treeNote.addRootNote",
          "when": "view == treeNoteView",
          "group": "navigation@2"
        },
        {
          "command": "treeNote.expandAll",
          "when": "view == treeNoteView && !treeNote.allExpanded",
          "group": "navigation@3"
        },
        {
          "command": "treeNote.collapseAll",
          "when": "view == treeNoteView && treeNote.allExpanded",
          "group": "navigation@3"
        },
        {
          "command": "treeNote.refreshEntry",
          "when": "view == treeNoteView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "treeNote.addFolder",
          "when": "view == treeNoteView && viewItem == noteParent",
          "group": "inline@1"
        },
        {
          "command": "treeNote.addNote",
          "when": "view == treeNoteView && (viewItem == noteParent || viewItem == noteParentMax)",
          "group": "inline@2"
        },
        {
          "command": "treeNote.renameNote",
          "when": "view == treeNoteView",
          "group": "inline@3"
        },
        {
          "command": "treeNote.deleteNote",
          "when": "view == treeNoteView",
          "group": "inline@4"
        },
        {
          "command": "treeNote.renameNote",
          "when": "view == treeNoteView",
          "group": "modification@1"
        },
        {
          "command": "treeNote.deleteNote",
          "when": "view == treeNoteView",
          "group": "modification@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean-cache": "rm -rf dist/*.vsix",
    "package": "./scripts/package.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3"
  }
}
